# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=

# Optional overrides
# CS329Z_GRADING_MODEL=openai/gpt-6-luna  # the model LM() calls (an OpenRouter name); grading uses the default
# CS329Z_REASONING_EFFORT=low # reasoning effort for models that accept it
# CS329Z_BUDGET_USD=25        # your own stop: the LM wrapper refuses new calls once the ledger reaches this
# CS329Z_EVAL_SLICE=5         # run live tests on the first N items only

# DeepSeek official API (all three roles default to deepseek-flash).
# Uncomment these two lines in .env to switch:
# CS329Z_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your-key
# Optional: use a different supported model for a role:
# CS329Z_JUDGE_MODEL=deepseek-v4-pro
# DeepSeek ledger costs use peak USD rates as conservative estimates.
